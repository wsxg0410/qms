---
import { PicList } from '@/components/react/PicList';
import { PicUploader } from '@/components/react/PicUploader';
import { ProjectManager } from '@/components/react/ProjectManager';
import { CF, IMG_URL } from '@/config/app.config';
import Layout from '../layouts/Layout.astro';

const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}
---

<Layout title="图片管理系统">
  <header
    class="flex justify-between items-center p-3 border-b border-gray-200 gap-5"
    data-ttt={JSON.stringify(CF)}
  >
    <div class="font-bold text-2xl flex-auto">IMS</div>
    <div>
      <ProjectManager client:idle />
    </div>
    <div>
      <a href="/api/auth/logout" class="text-red-500">Logout</a>
    </div>
  </header>
  <div class="bg-gray-100">
    <PicUploader client:idle />
  </div>
  <main class="p-3">
    <PicList client:idle />
  </main>
</Layout>
